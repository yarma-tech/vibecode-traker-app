{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Map",
  "identifier": "fr.yarma.vibemap.bureau",
  "build": {
    "frontendDist": "interface"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "copyright": "MIT - yarma-tech",
    "shortDescription": "La carte de tes codebases",
    "longDescription": "Vibe Map affiche une carte de tes depots qui s'allume quand un agent y travaille.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
